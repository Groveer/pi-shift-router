{
  "name": "pi-slim-router",
  "version": "0.4.0",
  "description": "Two-tier model router for pi-agent — automatic execution/judgment routing with LLM Judge. Pairs a fast everyday model with a strong model for planning and review.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "slim-router",
    "model-routing",
    "ai-router",
    "llm-router",
    "model-selection"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/green-dalii/pi-slim-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/green-dalii/pi-slim-router.git"
  },
  "bugs": {
    "url": "https://github.com/green-dalii/pi-slim-router/issues"
  },
  "author": {
    "name": "green-dalii",
    "url": "https://github.com/green-dalii"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "minPiVersion": "0.80.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules dist",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.81.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  }
}
